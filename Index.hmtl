<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Strawberries & Cigarettes Reading Shelf</title>
    <style>
        :root {
            --bg-color: #0d0d0f;
            --shelf-wood: #23150b;
            --shelf-rim: #331f11;
            --glow-color: rgba(255, 117, 140, 0.25);
        }

        body {
            margin: 0;
            padding: 0;
            background-color: var(--bg-color);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            overflow-x: hidden;
        }

        header {
            text-align: center;
            margin-bottom: 50px;
        }

        header h1 {
            font-size: 2.6rem;
            margin: 0 0 8px 0;
            font-weight: 700;
            letter-spacing: 1.5px;
            background: linear-gradient(45deg, #ff758c, #ff7eb3, #ffd3b6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        header p {
            font-size: 1rem;
            color: #71717a;
            margin: 0;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        /* Bookshelf Core Layout */
        .shelf-container {
            width: 90%;
            max-width: 1050px;
            position: relative;
        }

        .books-row {
            display: flex;
            justify-content: center;
            align-items: flex-end;
            gap: 35px;
            padding: 0 20px;
            height: 350px;
            position: relative;
            z-index: 2;
        }

        /* 3D Wrapper */
        .book-item {
            perspective: 1000px;
            cursor: pointer;
            text-align: center;
        }

        .book-cover {
            width: 165px;
            height: 255px;
            position: relative;
            transform-style: preserve-3d;
            transform: rotateY(-18deg) translateZ(0);
            transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1), box-shadow 0.4s ease;
            border-radius: 3px 6px 6px 3px;
            box-shadow: -10px 12px 20px rgba(0,0,0,0.7);
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }

        /* Smooth 3D Push-forward Animation */
        .book-item:hover .book-cover {
            transform: rotateY(0deg) translateY(-20px) scale(1.05);
            box-shadow: 0px 15px 30px var(--glow-color);
        }

        /* Physical Wood Shelf Base */
        .wooden-shelf {
            width: 100%;
            height: 22px;
            background: linear-gradient(to bottom, var(--shelf-rim), #1d1109);
            border-bottom: 14px solid var(--shelf-wood);
            border-radius: 4px;
            box-shadow: 0px 20px 40px rgba(0, 0, 0, 0.9);
            position: relative;
            z-index: 1;
            margin-top: -5px;
        }

        .shelf-shadow {
            width: 100%;
            height: 50px;
            background: linear-gradient(to bottom, rgba(0,0,0,0.6), transparent);
            position: absolute;
            bottom: -50px;
            left: 0;
        }

        /* Tooltip Labels */
        .title-tag {
            margin-top: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            color: #52525b;
            opacity: 0;
            transition: opacity 0.3s ease, color 0.3s ease;
            letter-spacing: 0.5px;
        }

        .book-item:hover .title-tag {
            opacity: 1;
            color: #ff758c;
        }
    </style>
</head>
<body>

    <header>
        <h1>Strawberries & Cigarettes</h1>
        <p>Ineryss Universe Collection</p>
    </header>

    <div class="shelf-container">
        <div class="books-row">
            
            <div class="book-item" onclick="openWattpad('http://wattpad.com/1356765359-between-the-rainbow-strawberries-and-cigarettes')">
                <div class="book-cover" style="background-image: url('https://img.wattpad.com/cover/345232331-256-k878292.jpg');"></div>
                <div class="title-tag">#1 Between the Rainbow</div>
            </div>

            <div class="book-item" onclick="openWattpad('https://www.wattpad.com/1368024159-over-the-horizon-strawberries-and-cigarettes')">
                <div class="book-cover" style="background-image: url('https://img.wattpad.com/cover/348108082-256-k142079.jpg');"></div>
                <div class="title-tag">#2 Over the Horizon</div>
            </div>

            <div class="book-item" onclick="openWattpad('https://www.wattpad.com/1417985310-behind-the-blue-skies-strawberries-and-cigarettes')">
                <div class="book-cover" style="background-image: url('https://img.wattpad.com/cover/361499923-256-k460195.jpg');"></div>
                <div class="title-tag">#3 Behind the Blue Skies</div>
            </div>

            <div class="book-item" onclick="openWattpad('https://www.wattpad.com/1460090708-under-the-roaring-thunders-strawberries-and')">
                <div class="book-cover" style="background-image: url('https://img.wattpad.com/cover/372619442-256-k102715.jpg');"></div>
                <div class="title-tag">#4 Under the Roaring Thunders</div>
            </div>

        </div>

        <div class="wooden-shelf">
            <div class="shelf-shadow"></div>
        </div>
    </div>

    <script>
        function openWattpad(url) {
            window.open(url, '_blank');
        }
    </script>
</body>
</html>
